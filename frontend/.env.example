# Frontend configuration (Vite — vars must be prefixed VITE_ and are inlined at build time)

# Backend API base URL. Leave empty for local dev — the Vite dev server proxies
# /api and /socket.io to http://localhost:8000 automatically (see vite.config.js).
VITE_API_URL=

# For production, set to your backend URL (App Runner / Cloud Run / Fly):
# VITE_API_URL=https://your-backend-domain.com
