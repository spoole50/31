{
  "name": "31-card-game-workspace",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "cd backend && ../.venv/bin/uvicorn main:app --reload --port 8000",
    "build": "npm --workspace frontend run build",
    "preview": "npm --workspace frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
