# Backend configuration (FastAPI + python-socketio)

# Port the ASGI server binds to (App Runner / Cloud Run set this automatically)
PORT=8000

# Comma-separated list of frontend origins allowed to call the API and open a
# Socket.IO connection. http://localhost:3000 is always permitted, so this can
# stay unset for local dev. REQUIRED in production — without it the deployed
# frontend will be blocked by CORS.
# ALLOWED_ORIGINS=https://31.spoole.dev

# Log verbosity: DEBUG, INFO (default), WARNING. DEBUG adds per-turn game
# events (timeouts, life loss, round results).
# LOG_LEVEL=INFO

# Abuse limits (defaults shown). Game/table creation is limited per client IP,
# and the server refuses new games/tables past the caps with HTTP 503.
# CREATE_RATE_LIMIT=10      # creates per minute per IP (games + tables)
# MAX_LIVE_GAMES=200        # local games held in memory
# MAX_LIVE_TABLES=100       # online tables held in memory
